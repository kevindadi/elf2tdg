digraph tdg {
  rankdir=LR;
  graph [fontname="Helvetica", label="elf2tdg TDG (concurrency projection)", labelloc=t];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555"];
  edge [fontname="Helvetica", fontsize=9];
  "fn:0x14820" [label="_start\n0x14820", fillcolor="#dff3df", color="#555555", style="rounded,filled"];
  "fn:0x1f510" [label="rust_concurrency::main\n0x1f510", fillcolor="#ffffff", color="#555555", style="rounded,filled"];
  "fn:task:0x1f510" [label="rust_concurrency::main::{closure#0}\n0x1f510", fillcolor="#f4ecf7", color="#7d3c98", style="rounded,filled,dashed"];
  "fn:task:0x1faa8" [label="rust_concurrency::main::{closure#1}::{closure#0}\n0x1faa8", fillcolor="#f4ecf7", color="#7d3c98", style="rounded,filled,dashed"];
  "ctx:main" [label="main", shape=box, style="filled", fillcolor="#eaf2f8", color="#444444"];
  "ctx:main" -> "fn:0x1f510" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:scoped:0x1faa8" [label="rust_concurrency::main::{closure#1}::{closure#0}\nscoped-thread", shape=box, style="filled,dashed", fillcolor="#f4ecf7", color="#7d3c98"];
  "ctx:scoped:0x1faa8" -> "fn:task:0x1faa8" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:startup" [label="startup", shape=box, style="filled", fillcolor="#e8f6ef", color="#444444"];
  "ctx:startup" -> "fn:0x14820" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:thread:0x1f510" [label="rust_concurrency::main::{closure#0}\nthread", shape=box, style="filled,dashed", fillcolor="#f4ecf7", color="#7d3c98"];
  "ctx:thread:0x1f510" -> "fn:task:0x1f510" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "scope:0x1f9c6" [label="thread scope\n0x1f9c6\n1 members", shape=ellipse, style="dashed,filled", fillcolor="#eafaf1", color="#1e8449"];
  "scope:0x1f9c6" -> "ctx:main" [label="in", style=dotted, color="#1e8449", fontcolor="#1e8449"];
  "scope:0x1f9c6" -> "ctx:scoped:0x1faa8" [label="member", style=dotted, color="#1e8449"];
  "fn:0x1f510" -> "ctx:thread:0x1f510" [label="Join", color="#2471a3", fontcolor="#2471a3", style="bold"];
  "opaque:e:join:0x1ff47" [label="join opaque (2 candidates)", shape=note, style="dashed,filled", fillcolor="#f4f6f7", color="#999999"];
  "fn:0x1f510" -> "opaque:e:join:0x1ff47" [label="Join?", color="#2471a3", fontcolor="#2471a3", style="bold"];
  "fn:0x1f510" -> "ctx:thread:0x1f510" [label="spawn (OsThread)", color="#c0392b", fontcolor="#c0392b", style="bold"];
  "fn:0x1f510" -> "ctx:scoped:0x1faa8" [label="spawn (ScopedThread)", color="#c0392b", fontcolor="#c0392b", style="bold"];
  "lock-node:lock:0x200c8:acquire:Mutex::lock" [label="lock Acquire\\nMutex::lock\\n0x200c8", shape=note, style="filled", fillcolor="#fef9e7", color="#b7950b"];
  "fn:0x1f510" -> "lock-node:lock:0x200c8:acquire:Mutex::lock" [label="lock", style=dotted, color="#b7950b", fontcolor="#b7950b"];
  "lock-node:lock:0x20125:release:MutexGuard::drop" [label="lock Release\\nMutexGuard::drop\\n0x20125", shape=note, style="filled", fillcolor="#fef9e7", color="#b7950b"];
  "fn:0x1f510" -> "lock-node:lock:0x20125:release:MutexGuard::drop" [label="lock", style=dotted, color="#b7950b", fontcolor="#b7950b"];
  "lock-node:lock:0x20271:acquire:Mutex::lock" [label="lock Acquire\\nMutex::lock\\n0x20271", shape=note, style="filled", fillcolor="#fef9e7", color="#b7950b"];
  "fn:0x1f510" -> "lock-node:lock:0x20271:acquire:Mutex::lock" [label="lock", style=dotted, color="#b7950b", fontcolor="#b7950b"];
  "lock-node:lock:0x2029b:release:MutexGuard::drop" [label="lock Release\\nMutexGuard::drop\\n0x2029b", shape=note, style="filled", fillcolor="#fef9e7", color="#b7950b"];
  "fn:0x1f510" -> "lock-node:lock:0x2029b:release:MutexGuard::drop" [label="lock", style=dotted, color="#b7950b", fontcolor="#b7950b"];
  "lock-node:lock:0x2035a:release:MutexGuard::drop" [label="lock Release\\nMutexGuard::drop\\n0x2035a", shape=note, style="filled", fillcolor="#fef9e7", color="#b7950b"];
  "fn:0x1f510" -> "lock-node:lock:0x2035a:release:MutexGuard::drop" [label="lock", style=dotted, color="#b7950b", fontcolor="#b7950b"];
  subgraph cluster_legend {
    label="Legend"; labeljust="l"; fontname="Helvetica"; fontsize=11; style="rounded,dashed"; color="#999999";
    legend_function [label="function", fillcolor="#ffffff"];
    legend_context [label="context", shape=box, style="filled", fillcolor="#eaf2f8", color="#444444"];
    legend_scope [label="scope", shape=ellipse, style="dashed,filled", fillcolor="#eafaf1", color="#1e8449"];
    legend_opaque [label="opaque target", shape=note, style="dashed,filled", fillcolor="#f4f6f7", color="#999999"];
    legend_vector [label="vector / IRQ", shape=diamond, style="filled", fillcolor="#fdebd0", color="#b9770e"];
    legend_lock [label="lock event", shape=note, style="filled", fillcolor="#fef9e7", color="#b7950b"];
    legend_function -> legend_lock [label="lock", style=dotted, color="#b7950b", fontcolor="#b7950b"];
    legend_note [label="contexts: startup green, main blue, thread purple,\nISR orange, async lavender\ndashed border = synthesized logical/orphan task\nspawn/join/await: bold = high/medium confidence,\ndashed = low/unknown, ? = low/unknown or unresolved", shape=plaintext, fontsize=9];
    legend_function -> legend_context [label="spawn", color="#c0392b", fontcolor="#c0392b", style=bold];
    legend_function -> legend_context [label="join", color="#2471a3", fontcolor="#2471a3", style=bold];
    legend_context -> legend_function [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
    legend_scope -> legend_context [label="member", style=dotted, color="#1e8449", fontcolor="#1e8449"];
    legend_vector -> legend_context [label="ISR", style=dashed, color="#b9770e", fontcolor="#b9770e"];
    legend_context -> legend_opaque [label="await? / spawn?", style="bold,dashed", color="#7d3c98", fontcolor="#7d3c98"];
  }
}
