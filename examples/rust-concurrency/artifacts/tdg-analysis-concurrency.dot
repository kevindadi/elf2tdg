digraph tdg {
  rankdir=LR;
  graph [fontname="Helvetica", label="elf2tdg TDG (concurrency projection)", labelloc=t];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555"];
  edge [fontname="Helvetica", fontsize=9];
  "fn:0x8000400" [label="Reset\n0x8000400\n22-49 cyc", fillcolor="#dff3df", color="#555555", style="rounded,filled"];
  "fn:0x80004aa" [label="<embassy_executor::platform::thread::Executor>::run::<rust_concurrency:...\n0x80004aa\n137-210 cyc", fillcolor="#ffffff", color="#555555", style="rounded,filled"];
  "fn:0x80005ea" [label="rust_concurrency::start_tasks\n0x80005ea\n168-263 cyc", fillcolor="#ffffff", color="#555555", style="rounded,filled"];
  "fn:0x800082a" [label="<embassy_executor::raw::TaskStorage<rust_concurrency::__app_main_task::...\n0x800082a\n21-32 cyc", fillcolor="#ffffff", color="#555555", style="rounded,filled"];
  "fn:0x800085c" [label="<embassy_executor::raw::TaskStorage<rust_concurrency::__sensor_task_tas...\n0x800085c\n26-39 cyc", fillcolor="#ffffff", color="#555555", style="rounded,filled"];
  "fn:0x800089a" [label="<embassy_executor::raw::TaskStorage<rust_concurrency::__monitor_task_ta...\n0x800089a\n26-37 cyc", fillcolor="#ffffff", color="#555555", style="rounded,filled"];
  "fn:0x80008de" [label="main\n0x80008de\n3-8 cyc", fillcolor="#ffffff", color="#555555", style="rounded,filled"];
  "fn:0x80008e6" [label="HardFault\n0x80008e6\n3-8 cyc", fillcolor="#fff1c9", color="#555555", style="rounded,filled"];
  "ctx:async:0x80004e4" [label="rust_concurrency::app_main\nasync-task", shape=box, style="filled", fillcolor="#e8daef", color="#444444"];
  "ctx:async:0x80004e4" -> "fn:0x800082a" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:async:0x800061c" [label="rust_concurrency::sensor_task\nasync-task", shape=box, style="filled", fillcolor="#e8daef", color="#444444"];
  "ctx:async:0x800061c" -> "fn:0x800085c" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:async:0x80006ec" [label="rust_concurrency::monitor_task\nasync-task", shape=box, style="filled", fillcolor="#e8daef", color="#444444"];
  "ctx:async:0x80006ec" -> "fn:0x800089a" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:isr:3" [label="HardFault\nisr", shape=box, style="filled", fillcolor="#fdebd0", color="#444444"];
  "ctx:isr:3" -> "fn:0x80008e6" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:main" [label="main", shape=box, style="filled", fillcolor="#eaf2f8", color="#444444"];
  "ctx:main" -> "fn:0x80008de" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:startup" [label="startup", shape=box, style="filled", fillcolor="#e8f6ef", color="#444444"];
  "ctx:startup" -> "fn:0x8000400" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "vector:3" [label="vector 3", shape=diamond, style="filled", fillcolor="#fdebd0", color="#b9770e"];
  "vector:3" -> "ctx:isr:3" [label="vector 3", color="#b9770e", fontcolor="#b9770e", style=dashed];
  "fn:0x80004aa" -> "ctx:async:0x80004e4" [label="spawn (AsyncTask)", color="#c0392b", fontcolor="#c0392b", style="bold"];
  "fn:0x80005ea" -> "ctx:async:0x800061c" [label="spawn (AsyncTask)", color="#c0392b", fontcolor="#c0392b", style="bold"];
  "fn:0x80005ea" -> "ctx:async:0x80006ec" [label="spawn (AsyncTask)", color="#c0392b", fontcolor="#c0392b", style="bold"];
  subgraph cluster_legend {
    label="Legend"; labeljust="l"; fontname="Helvetica"; fontsize=11; style="rounded,dashed"; color="#999999";
    legend_function [label="function", fillcolor="#ffffff"];
    legend_context [label="context", shape=box, style="filled", fillcolor="#eaf2f8", color="#444444"];
    legend_scope [label="scope", shape=ellipse, style="dashed,filled", fillcolor="#eafaf1", color="#1e8449"];
    legend_opaque [label="opaque target", shape=note, style="dashed,filled", fillcolor="#f4f6f7", color="#999999"];
    legend_vector [label="vector / IRQ", shape=diamond, style="filled", fillcolor="#fdebd0", color="#b9770e"];
    legend_lock [label="lock event", shape=note, style="filled", fillcolor="#fef9e7", color="#b7950b"];
    legend_function -> legend_lock [label="lock", style=dotted, color="#b7950b", fontcolor="#b7950b"];
    legend_note [label="contexts: startup green, main blue, thread purple,\nISR orange, async lavender\ndashed border = synthesized logical/orphan task\nspawn/join/await: bold = high/medium confidence,\ndashed = low/unknown, ? = low/unknown or unresolved", shape=plaintext, fontsize=9];
    legend_function -> legend_context [label="spawn", color="#c0392b", fontcolor="#c0392b", style=bold];
    legend_function -> legend_context [label="join", color="#2471a3", fontcolor="#2471a3", style=bold];
    legend_context -> legend_function [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
    legend_scope -> legend_context [label="member", style=dotted, color="#1e8449", fontcolor="#1e8449"];
    legend_vector -> legend_context [label="ISR", style=dashed, color="#b9770e", fontcolor="#b9770e"];
    legend_context -> legend_opaque [label="await? / spawn?", style="bold,dashed", color="#7d3c98", fontcolor="#7d3c98"];
  }
}
