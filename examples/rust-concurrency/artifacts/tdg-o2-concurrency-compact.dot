digraph tdg {
  rankdir=LR;
  graph [fontname="Helvetica", label="elf2tdg TDG (concurrency projection)", labelloc=t];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555"];
  edge [fontname="Helvetica", fontsize=9];
  "fn:0x17a70" [label="_start\n0x17a70", fillcolor="#dff3df", color="#555555", style="rounded,filled"];
  "fn:0x18510" [label="main::main\n0x18510", fillcolor="#ffffff", color="#555555", style="rounded,filled"];
  "fn:task:0x18510" [label="main::main::{closure#0}\n0x18510", fillcolor="#f4ecf7", color="#7d3c98", style="rounded,filled,dashed"];
  "fn:task:0x188f4" [label="main::main::{closure#1}::{closure#0}\n0x188f4", fillcolor="#f4ecf7", color="#7d3c98", style="rounded,filled,dashed"];
  "ctx:main" [label="main", shape=box, style="filled", fillcolor="#eaf2f8", color="#444444"];
  "ctx:main" -> "fn:0x18510" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:scoped:0x188f4" [label="main::main::{closure#1}::{closure#0}\nscoped-thread", shape=box, style="filled,dashed", fillcolor="#f4ecf7", color="#7d3c98"];
  "ctx:scoped:0x188f4" -> "fn:task:0x188f4" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:startup" [label="startup", shape=box, style="filled", fillcolor="#e8f6ef", color="#444444"];
  "ctx:startup" -> "fn:0x17a70" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "ctx:thread:0x18510" [label="main::main::{closure#0}\nthread", shape=box, style="filled,dashed", fillcolor="#f4ecf7", color="#7d3c98"];
  "ctx:thread:0x18510" -> "fn:task:0x18510" [label="entry", style=dotted, color="#4a6fa5", fontcolor="#4a6fa5"];
  "scope:0x18882" [label="thread scope\n0x18882\n1 members", shape=ellipse, style="dashed,filled", fillcolor="#eafaf1", color="#1e8449"];
  "scope:0x18882" -> "ctx:main" [label="in", style=dotted, color="#1e8449", fontcolor="#1e8449"];
  "scope:0x18882" -> "ctx:scoped:0x188f4" [label="member", style=dotted, color="#1e8449"];
  "fn:0x18510" -> "ctx:thread:0x18510" [label="Join", color="#2471a3", fontcolor="#2471a3", style="bold"];
  "opaque:e:join:0x18c41" [label="join opaque (2 candidates)", shape=note, style="dashed,filled", fillcolor="#f4f6f7", color="#999999"];
  "fn:0x18510" -> "opaque:e:join:0x18c41" [label="Join?", color="#2471a3", fontcolor="#2471a3", style="bold"];
  "fn:0x18510" -> "ctx:thread:0x18510" [label="spawn (OsThread)", color="#c0392b", fontcolor="#c0392b", style="bold"];
  "fn:0x18510" -> "ctx:scoped:0x188f4" [label="spawn (ScopedThread)", color="#c0392b", fontcolor="#c0392b", style="bold"];
}
