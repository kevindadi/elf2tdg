  n2["sensor_task<br/>0x8000118<br/>20-26 cyc"]
  n3["USART1_IRQHandler<br/>0x8000138<br/>16-20 cyc"]
  n4["main<br/>0x8000150<br/>9-17 cyc"]
  n5["Reset_Handler<br/>0x8000160<br/>7-13 cyc"]
